# cmake -DIN=<file> -DOUT=<header> -DNAME=<identifier> -P embed.cmake : any file -> `static const unsigned char NAME[]`
# + `NAME_len` (the core's cmake/embed.cmake with the array name as a parameter; used for openapi.json and llms.txt).
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" len)
math(EXPR n "${len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
file(WRITE "${OUT}" "// generated by server/cmake/embed.cmake from ${IN}\n#include <cstddef>\nstatic const unsigned char ${NAME}[] = {${arr}};\nstatic const size_t ${NAME}_len = ${n};\n")
