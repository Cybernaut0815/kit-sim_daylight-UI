{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "daylight-mesh": ["../kit-sim_daylight/bindings/ts/src/index.ts"],
      "usd-viewer": ["../USD_WebViewer/web/src/index.ts"],
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/webgpu": ["./node_modules/@types/three/src/Three.WebGPU.d.ts"],
      "three/tsl": ["./node_modules/@types/three/src/Three.TSL.d.ts"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"],
      "@gltf-transform/core": ["./node_modules/@gltf-transform/core"]
    }
  },
  "include": ["src", "../kit-sim_daylight/bindings/ts/src/index.ts"]
}
